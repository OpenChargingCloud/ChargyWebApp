+import {describe,expect,test} from 'vitest';
+import {compareObservedVersions,emptyObservedVersions,type VersionObservation} from '../src/index.ts';
+const point=(position:number,digest:string,previous?:string):VersionObservation=>({kind:'checkpoint',chain:'network',epoch:'1',position,revision:position,digest:digest.repeat(64),original:'signed original',...(previous===undefined?{}:{previous:previous.repeat(64)})});
+describe('Local authenticated version comparisons (no authorization granted)',()=>{
+    test('persists negative constraints across independent comparisons, idempotently matching exact versions',()=>{
+        const a=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'current',1);expect(a.accepted).toBe(true);
+        expect(compareObservedVersions(a.state,[point(0,'a')],'current',2).status).toBe('matches');
+        const b=compareObservedVersions(a.state,[point(1,'b','a')],'current',3);expect(b.accepted).toBe(true);
+        expect(compareObservedVersions(b.state,[point(0,'a')],'current',4).issues.some(issue=>issue.code==='rollback')).toBe(true);
+        expect(compareObservedVersions(b.state,[point(0,'a')],'historical',4).accepted).toBe(true);
+    });
+    test('a fork is retained and quarantines later source switches',()=>{
+        const a=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'current',1);
+        const fork=compareObservedVersions(a.state,[point(0,'b')],'current',2);expect(fork.accepted).toBe(false);expect(fork.state.points[0]?.digest).toBe('a'.repeat(64));
+        expect(fork.state.conflicts).toHaveLength(1);expect(compareObservedVersions(fork.state,[point(0,'a')],'current',3).issues.some(issue=>issue.code==='known-fork')).toBe(true);
+    });
+    test('missing links do not advance an accepted head and may subsequently be supplied',()=>{
+        const a=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'current',1);
+        const gap=compareObservedVersions(a.state,[point(2,'c','b')],'current',2);expect(gap.issues.some(issue=>issue.code==='continuity-missing')).toBe(true);
+        expect(gap.state.heads[JSON.stringify(['checkpoint','network'])]?.position).toBe(0);
+        const filled=compareObservedVersions(gap.state,[point(1,'b','a'),point(2,'c','b')],'current',3);expect(filled.accepted).toBe(true);
+    });
+    test('known adjacent predecessor contradictions and epoch resets cannot hide behind valid hashes',()=>{
+        const a=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'current',1);
+        expect(compareObservedVersions(a.state,[point(1,'b','c')],'current',2).issues.some(issue=>issue.code==='link')).toBe(true);
+        expect(compareObservedVersions(a.state,[{...point(0,'b'),epoch:'2'}],'current',2).issues.some(issue=>issue.code==='epoch-transition')).toBe(true);
+    });
+    test('ordered snapshots and irregular live timestamps have different continuity rules',()=>{
+        const a=compareObservedVersions(emptyObservedVersions(),[{...point(5,'a'),kind:'station'}],'current',1);
+        expect(compareObservedVersions(a.state,[{...point(90,'b'),kind:'station'}],'current',2).accepted).toBe(true);
+        const live=compareObservedVersions(emptyObservedVersions(),[{...point(1000,'a'),kind:'live'}],'current',1);
+        expect(compareObservedVersions(live.state,[{...point(9000,'b','a'),kind:'live'}],'current',2).accepted).toBe(true);
+    });
+});
+
+test('a rejected gap cannot become accepted just by submitting its tip again',()=>{
+    const start=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'current',1);
+    const gap=compareObservedVersions(start.state,[point(2,'c','b')],'current',2);
+    expect(compareObservedVersions(gap.state,[point(2,'c','b')],'current',3).accepted).toBe(false);
+    const filler=compareObservedVersions(gap.state,[point(1,'b','a')],'current',4);expect(filler.accepted).toBe(false);
+    expect(compareObservedVersions(filler.state,[point(2,'c','b')],'current',5).accepted).toBe(true);
+});
+test('mixed current epochs are not merged and historical observations never advance current heads',()=>{
+    expect(compareObservedVersions(emptyObservedVersions(),[point(0,'a'),{...point(0,'b'),epoch:'2'}],'current',1).accepted).toBe(false);
+    const history=compareObservedVersions(emptyObservedVersions(),[point(0,'a')],'historical',2);expect(history.state.heads).toEqual({});
+    expect(compareObservedVersions(history.state,[point(1,'b','a')],'current',3).accepted).toBe(true);
+});
+test('known forks quarantine only their own chain and identity changes cannot pin a new live key',()=>{
+    const live={...point(0,'a'),kind:'live' as const,identity:'1'.repeat(64)};
+    const initial=compareObservedVersions(emptyObservedVersions(),[live],'current',1);
+    const changed=compareObservedVersions(initial.state,[{...live,position:1,digest:'b'.repeat(64),previous:live.digest,identity:'2'.repeat(64)}],'current',2);
+    expect(changed.issues.some(issue=>issue.code==='identity')).toBe(true);
+    expect(compareObservedVersions(changed.state,[point(0,'c')],'current',3).accepted).toBe(true);
+});
+test('capacity limits do not silently evict observations and larger standardized hash sizes remain supported',()=>{
+    expect(compareObservedVersions(emptyObservedVersions(),[{...point(0,'a'),digest:'b'.repeat(96)}],'current',1).accepted).toBe(true);
+    const history={...emptyObservedVersions(),points:Array.from({length:4096},(_,index)=>({...point(index,'a'),chain:String(index)}))};
+    expect(()=>compareObservedVersions(history,[{...point(0,'b'),chain:'overflow'}],'historical',1)).toThrow(/capacity/);
+});
+
+test('different live timestamps do not hide two children of the same authenticated predecessor',()=>{
+    const first={...point(0,'a'),kind:'live' as const},second={...point(1000,'b','a'),kind:'live' as const};
+    const accepted=compareObservedVersions(emptyObservedVersions(),[first,second],'current',1);
+    const sibling={...point(2000,'c','a'),kind:'live' as const};
+    expect(compareObservedVersions(accepted.state,[sibling],'historical',2).issues.some(issue=>issue.code==='link')).toBe(true);
+});
diff --git a/tests/sessionPrices.test.ts b/tests/sessionPrices.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/sessionPrices.test.ts
@@ -0,0 +1,45 @@
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {describe,expect,test} from 'vitest';
+import {parseJSON,prettyJSON,TrustAnchor,KeyStatement,HistoricalTrustContext,verifySessionPriceEvidence,parseTrustedWitnesses,verifyAuthorizedCheckpoint,Checkpoint,type JSONObject} from '../src/index.ts';
+const input=(name:string):JSONObject=>parseJSON(readFileSync(new URL(`./vectors/session-price-${name}.json`,import.meta.url),'utf8')) as JSONObject;
+function example(name:string='ed'): {context:HistoricalTrustContext;evidence:JSONObject;request:{evseId:string;meterSerialNumber:string;chargingStarted:number;startDocumentSHA256:string}} {
+    const raw=input(name),poi=raw['poiEvidence'] as JSONObject,bootstrap=poi['bootstrap'] as JSONObject,anchor=TrustAnchor.parse(bootstrap['trustAnchor'] as string);
+    const context=HistoricalTrustContext.create(anchor,KeyStatement.parse((bootstrap['keyStatement'] as JSONObject)['keyStatement']),{trustedIdentityKeyIds:anchor.keys,now:Date.parse('2026-11-01T00:16:21Z')});
+    return {context,evidence:poi['priceEvidence'] as JSONObject,request:{evseId:'DE*POI*E1*1',meterSerialNumber:'CHARGY-POI-METER-001',chargingStarted:Date.parse('2026-06-01T10:00:00Z'),startDocumentSHA256:createHash('sha256').update(raw['ocmfBegin'] as string).digest('hex')}};
+}
+describe('CPO price assignment and separate publication evidence',()=>{
+    test.each(['ed','pqc'])('%s uses the existing generic signature algorithms and a fixed price at the original start',name=>{
+        const e=example(name),result=verifySessionPriceEvidence(e.context,e.evidence,e.request);
+        expect(result.signatures).toBe('valid');expect(result.agreement).toBe('valid');expect(result.applicability).toBe('bound');expect(result.publication).toBe('valid');
+        expect(result.selected?.statement['algorithm']).toBe(name==='ed'?'Ed25519':'ML-DSA-65');
+        expect(result.publicationBeforeStart).toBe('not-proven');expect(result.customerConsent).toBe('not-proven');
+        expect(result.witnessedBy).toEqual([]);
+    });
+    test('signed decimals survive serialization and are never normalized through binary floating point',()=>{
+        const e=example('decimal'),result=verifySessionPriceEvidence(e.context,parseJSON(prettyJSON(e.evidence)),e.request);
+        expect(result.selected?.rates?.energyPerKWh).toBe('0.3500');expect(result.applicability).toBe('bound');
+    });
+    test('missing or tampered assignment cannot establish binding',()=>{
+        const e=example();delete e.evidence['agreement'];expect(verifySessionPriceEvidence(e.context,e.evidence,e.request).applicability).toBe('unbound');
+        const changed=example();(changed.evidence['agreement'] as JSONObject)['startDocumentSHA256']='ff'.repeat(32);
+        expect(verifySessionPriceEvidence(changed.context,changed.evidence,changed.request).agreement).toBe('invalid');
+    });
+    test('publication is separate and requires supplied inclusion and explicit witness authority',()=>{
+        const e=example();delete e.evidence['priceStatementProofs'];delete e.evidence['checkpoints'];
+        const pending=verifySessionPriceEvidence(e.context,e.evidence,e.request);expect(pending.applicability).toBe('bound');expect(pending.publication).toBe('missing');
+        const complete=example();expect(verifySessionPriceEvidence(complete.context,complete.evidence,complete.request,{requiredWitnesses:1}).publication).toBe('invalid');
+        const witnesses=parseTrustedWitnesses(parseJSON(readFileSync(new URL('./vectors/history-witnesses.json',import.meta.url),'utf8')));
+        expect(verifySessionPriceEvidence(complete.context,complete.evidence,complete.request,{witnesses,requiredWitnesses:1}).publication).toBe('valid');
+    });
+    test('the shared checkpoint authority independently rejects malformed compromise times',()=>{
+        const e=example(),entry=(e.evidence['checkpoints'] as JSONObject[])[0];if(entry===undefined)throw new Error('Missing checkpoint');
+        expect(()=>verifyAuthorizedCheckpoint(e.context,Checkpoint.parse(entry['checkpoint']),entry['operator']??null,{revocations:[{keyId:'test',invalidFrom:NaN}]})).toThrow(/compromise/);
+    });
+    test('foreign subjects and revoked CPO keys are refused without importing authority from evidence',()=>{
+        const e=example();expect(()=>verifySessionPriceEvidence(e.context,e.evidence,{...e.request,evseId:'FOREIGN'})).toThrow();
+        const keyId=((e.evidence['priceStatements'] as JSONObject[])[0] as JSONObject)['keyId'] as string;
+        expect(verifySessionPriceEvidence(e.context,e.evidence,e.request,{revocations:[{keyId,invalidFrom:0}]}).signatures).toBe('invalid');
+        expect(()=>HistoricalTrustContext.create(e.context.authorizedAnchor,KeyStatement.parse((((input('ed')['poiEvidence'] as JSONObject)['bootstrap'] as JSONObject)['keyStatement'] as JSONObject)['keyStatement']),{trustedIdentityKeyIds:[]})).toThrow();
+    });
+});
diff --git a/tests/trustTransitions.test.ts b/tests/trustTransitions.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/trustTransitions.test.ts
@@ -0,0 +1,57 @@
+import {readFileSync} from 'node:fs';
+import {describe,expect,test} from 'vitest';
+import {TrustAnchor,TrustContext,KeyStatement,TrustTransition,VerifiedTrustTransition,initialTrustEpoch,EpochProfiles,verifyChargingStation,parseJSON,applyVerifiedTrustTransition,emptyObservedVersions,compareObservedVersions,checkpointVersionObservation,checkpointRootVersionObservation,Checkpoint,verifyChargingDocumentKeys} from '../src/index.ts';
+import type {JSONObject} from '../src/index.ts';
+const data=parseJSON(readFileSync(new URL('./vectors/trust-transitions.json',import.meta.url),'utf8')) as JSONObject;
+const required=(name:string):JSONObject=>data[name] as JSONObject,anchor=TrustAnchor.parse(data['anchor'] as string),operator=required('operator'),now=Date.parse(data['now'] as string);
+const context=():TrustContext=>TrustContext.create(anchor,KeyStatement.parse(operator['keyStatement']),{trustedIdentityKeyIds:anchor.keys,at:now});
+function verified(name:string='policy'):VerifiedTrustTransition{return VerifiedTrustTransition.verify(context(),operator,TrustTransition.parse(data[name]??null),{acceptedAt:now,epoch:initialTrustEpoch(),sequence:0});}
+describe('Experimental compact trust succession',()=>{
+    test('both independently counted holder quorums authorize the exact target policy and identity keys',()=>{
+        const result=verified();expect(result.context.requiredConsensus).toBe(2);expect(result.signedBy.old).toHaveLength(2);expect(result.signedBy.next).toHaveLength(2);
+        expect(result.context.anchor.urls[0]).toContain('next.poi.example');expect(result.context.anchor.keys.some(id=>anchor.keys.includes(id))).toBe(false);
+    });
+    test('a new-only or old-only signature set cannot establish succession',()=>{
+        for(const side of ['old','new']){const original=required('policy'),changed={...original,signatures:(original['signatures'] as JSONObject[]).filter(signature=>signature['side']===side)};
+            expect(()=>VerifiedTrustTransition.verify(context(),operator,TrustTransition.parse(changed),{acceptedAt:now,epoch:initialTrustEpoch(),sequence:0})).toThrow(/quorum/);}
+    });
+    test('changing target URLs, sequence, parent, statement or interval does not preserve authorization',()=>{
+        for(const change of ([{toAnchor:anchor.toQRCode()},{fromStatementDigest:'00'.repeat(32)},{signedAt:'2031-01-01T00:00:00.000Z'}] as JSONObject[]))
+            expect(()=>VerifiedTrustTransition.verify(context(),operator,TrustTransition.parse({...required('policy'),...change}),{acceptedAt:now,epoch:initialTrustEpoch(),sequence:0})).toThrow();
+        expect(()=>VerifiedTrustTransition.verify(context(),operator,TrustTransition.parse(data['policy']??null),{acceptedAt:now,epoch:initialTrustEpoch(),sequence:1})).toThrow();
+    });
+    test('policy succession preserves old points and is idempotent when reverified',()=>{
+        const cp=Checkpoint.parse(data['head']),state=compareObservedVersions(emptyObservedVersions(),[checkpointVersionObservation(cp),checkpointRootVersionObservation(cp)],'current',now).state;
+        const changed=applyVerifiedTrustTransition(state,verified(),now);expect(changed.accepted).toBe(true);expect(changed.state.points.some(point=>point.digest===cp.id)).toBe(true);
+        expect(changed.state.transitions).toHaveLength(1);expect(applyVerifiedTrustTransition(changed.state,verified(),now).state.transitions).toHaveLength(1);
+    });
+    test('a final checkpoint may close the same root; the exact deterministic genesis opens the next epoch without clearing old points',()=>{
+        const cp=Checkpoint.parse(data['head']),before=compareObservedVersions(emptyObservedVersions(),[checkpointVersionObservation(cp),checkpointRootVersionObservation(cp)],'current',now).state;
+        const result=applyVerifiedTrustTransition(before,verified('epoch'),now);expect(result.accepted).toBe(true);
+        expect(result.state.heads[JSON.stringify(['checkpoint','network'])]?.epoch).toBe('2');expect(result.state.heads[JSON.stringify(['station','network'])]?.epoch).toBe('2');
+        expect(result.state.points.some(point=>point.digest===cp.id)).toBe(true);expect(result.state.points.some(point=>point.kind==='checkpoint'&&point.final===true)).toBe(true);
+        expect(compareObservedVersions(result.state,[checkpointVersionObservation(cp)],'current',now).accepted).toBe(false);
+    });
+    test('an epoch jump does not erase a previously authenticated fork',()=>{
+        const cp=Checkpoint.parse(data['head']),point=checkpointVersionObservation(cp),before=compareObservedVersions(emptyObservedVersions(),[point],'current',now).state;
+        const fork=compareObservedVersions(before,[{...point,digest:'ab'.repeat(32)}],'historical',now).state;
+        expect(applyVerifiedTrustTransition(fork,verified('epoch'),now).accepted).toBe(false);
+    });
+});
+describe('POI-authorized CPO document keys',()=>{
+    test('maps real COSE keys without imposing the meter pilot on CPO signatures',()=>{
+        const keys=verifyChargingDocumentKeys(context(),data['baseProof']??null,{evseId:'DE*POI*E1*1',operatorId:'DE*POI',at:Date.parse('2026-11-01T00:05:01.000Z')});
+        expect(keys.keys[0]?.algorithm).toBe('EdDSA-Ed25519');expect(keys.keys[0]?.encodings).toEqual(['COSE_Key','CBOR','base64']);
+        expect(()=>verifyChargingDocumentKeys(context(),data['baseProof']??null,{evseId:'DE*POI*E1*1',operatorId:'FOREIGN',at:now})).toThrow();
+    });
+});
+
+test('verified epoch profiles constrain current station identifications, signature algorithms and epoch start',()=>{
+    const result=verified('epoch');
+    expect(verifyChargingStation(result.context,data['epochProof']??null,{evseId:'DE*POI*E1*1'}).attestedBy).toHaveLength(2);
+    expect(()=>verifyChargingStation(result.context,data['baseProof']??null,{evseId:'DE*POI*E1*1'})).toThrow();
+    const epoch={...result.epoch,profiles:EpochProfiles.parse({...result.epoch.profiles.toJSON(),signatureAlgorithms:['ML-DSA-65']})};
+    expect(()=>verifyChargingStation(TrustContext.withEpoch(result.context,epoch),data['epochProof']??null,{evseId:'DE*POI*E1*1'})).toThrow();
+});
+
+ test('even a dual-quorum wrapper does not authorize a malformed target operational certificate',()=>{expect(()=>verified('invalidCertificate')).toThrow();});
